def get_moving_averages(prices, short_ma_period, long_ma_period):
    short_ma = pd.Series(prices).rolling(window=short_ma_period).mean()
    long_ma = pd.Series(prices).rolling(window=long_ma_period).mean()
    return short_ma, long_ma

def check_crossover(short_ma, long_ma):
    if short_ma > long_ma:
        return 'over'
    elif short_ma < long_ma:
        return 'under'

def place_trade(prediction):
    if prediction == 'over':
        api.buy_contract('OVER', stake_amount, trade_duration)
    elif prediction == 'under':
        api.buy_contract('UNDER', stake_amount, trade_duration)

